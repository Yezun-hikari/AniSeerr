<%- include('partials/header') %>
<%
  const option = (value, current, fallback) =>
    `<option value="${value}"${(current || fallback) === value ? ' selected' : ''}>${value}</option>`;
  // Enabled sites first in saved order, then the remaining supported ones unchecked.
  const siteRows = (value, fallback, known) => {
    const on = (value || fallback).split(',').map(s => s.trim()).filter(s => known.includes(s));
    return [...on.map(id => ({ id, on: true })), ...known.filter(s => !on.includes(s)).map(id => ({ id, on: false }))];
  };
%>
<div class="mt-4">
  <h2>Settings</h2>

  <% if (success) { %>
    <div class="alert alert-success">Settings saved successfully.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form method="POST" action="/settings">
    <div class="row">
      <div class="col-md-6 mb-3">
        <label class="form-label" for="aniworld_url">AniWorld-Downloader URL</label>
        <input type="text" class="form-control" name="aniworld_url" id="aniworld_url" value="<%= settings.aniworld_url || '' %>" placeholder="http://localhost:8080" required>
      </div>
      <div class="col-md-6 mb-3">
        <label class="form-label" for="aniworld_api_key">AniWorld API Key</label>
        <input type="password" class="form-control" name="aniworld_api_key" id="aniworld_api_key" value="" autocomplete="new-password" placeholder="<%= settings.aniworld_api_key ? 'Saved (leave empty to keep)' : 'awd_...' %>">
        <% if (settings.aniworld_api_key) { %>
        <div class="form-check mt-1">
          <input class="form-check-input" type="checkbox" name="clear_api_key" value="1" id="clear_api_key">
          <label class="form-check-label" for="clear_api_key">Clear saved key</label>
        </div>
        <% } %>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6 mb-3">
        <h4>Movie Preferences</h4>

        <label class="form-label">Movie Site Priority (tick to use, drag to reorder)</label>
        <input type="hidden" name="movie_site" id="movie_site_input" value="">
        <ul id="movie-sortable" class="list-group mb-3 site-list" data-input="movie_site_input" style="cursor: grab;">
          <% siteRows(settings.movie_site, DEFAULT_MOVIE_SITES, MOVIE_SITES).forEach(row => { %>
            <li class="list-group-item list-group-item-dark d-flex align-items-center gap-2" data-id="<%= row.id %>">
              <input class="form-check-input m-0" type="checkbox" id="movie-site-<%= row.id %>" <%= row.on ? 'checked' : '' %>>
              <label class="form-check-label flex-grow-1" for="movie-site-<%= row.id %>"><%= row.id %></label>
              <span aria-hidden="true">↕</span>
            </li>
          <% }); %>
        </ul>

        <label class="form-label">Provider</label>
        <select class="form-select mb-2" name="movie_provider">
          <% PROVIDERS.forEach(p => { %><%- option(p, settings.movie_provider, DEFAULT_PROVIDER) %><% }); %>
        </select>

        <label class="form-label">Language</label>
        <select class="form-select mb-2" name="movie_language">
          <% LANGUAGES.forEach(l => { %><%- option(l, settings.movie_language, DEFAULT_LANGUAGE) %><% }); %>
        </select>

        <label class="form-label">Default Download Path</label>
        <select class="form-select path-select" name="default_movie_path" data-selected="<%= settings.default_movie_path || '' %>">
          <option value="<%= settings.default_movie_path || '' %>"><%= settings.default_movie_path ? 'Saved path (ID ' + settings.default_movie_path + ')' : 'Default Path' %></option>
        </select>
      </div>

      <div class="col-md-6 mb-3">
        <h4>Series Preferences</h4>
        <label class="form-label">Series Site Priority (tick to use, drag to reorder)</label>
        <input type="hidden" name="series_site" id="series_site_input" value="">
        <ul id="series-sortable" class="list-group mb-3 site-list" data-input="series_site_input" style="cursor: grab;">
          <% siteRows(settings.series_site, DEFAULT_SERIES_SITES, SERIES_SITES).forEach(row => { %>
            <li class="list-group-item list-group-item-dark d-flex align-items-center gap-2" data-id="<%= row.id %>">
              <input class="form-check-input m-0" type="checkbox" id="series-site-<%= row.id %>" <%= row.on ? 'checked' : '' %>>
              <label class="form-check-label flex-grow-1" for="series-site-<%= row.id %>"><%= row.id %></label>
              <span aria-hidden="true">↕</span>
            </li>
          <% }); %>
        </ul>

        <label class="form-label">Provider</label>
        <select class="form-select mb-2" name="series_provider">
          <% PROVIDERS.forEach(p => { %><%- option(p, settings.series_provider, DEFAULT_PROVIDER) %><% }); %>
        </select>

        <label class="form-label">Anime Language</label>
        <select class="form-select mb-2" name="anime_language">
          <% LANGUAGES.forEach(l => { %><%- option(l, settings.anime_language, DEFAULT_LANGUAGE) %><% }); %>
        </select>

        <label class="form-label">Series Language</label>
        <select class="form-select mb-2" name="series_language">
          <% LANGUAGES.forEach(l => { %><%- option(l, settings.series_language, DEFAULT_LANGUAGE) %><% }); %>
        </select>

        <label class="form-label">Default Download Path</label>
        <select class="form-select path-select" name="default_series_path" data-selected="<%= settings.default_series_path || '' %>">
          <option value="<%= settings.default_series_path || '' %>"><%= settings.default_series_path ? 'Saved path (ID ' + settings.default_series_path + ')' : 'Default Path' %></option>
        </select>
      </div>
    </div>

    <button type="submit" class="btn btn-primary">Save Settings</button>
    <button type="button" class="btn btn-secondary" onclick="fetchPaths()">Load Paths from AniWorld</button>
  </form>
</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.7/Sortable.min.js" integrity="sha384-DgmC6Xe2bSN2WjTDXzWYbUbxyhNP+NNkGDR/g78pCXV7E7rcVTGxVg0uIVCUUcBc" crossorigin="anonymous"></script>
<script>
  // Initialize Sortable Lists
  // Hidden input = ticked sites in list order.
  document.querySelectorAll('.site-list').forEach(list => {
    const input = document.getElementById(list.dataset.input);
    const sync = () => {
      input.value = Array.from(list.children)
        .filter(li => li.querySelector('input').checked)
        .map(li => li.dataset.id).join(',');
    };
    new Sortable(list, { animation: 150, onSort: sync });
    list.addEventListener('change', sync);
    sync();
  });

  async function fetchPaths(showAlerts = true) {
    try {
      const resp = await fetch('/api/paths');
      const data = await resp.json();

      if (resp.ok && data.paths) {
        document.querySelectorAll('.path-select').forEach(select => {
          const selected = select.getAttribute('data-selected');
          select.innerHTML = '<option value="">Default Path</option>';
          data.paths.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.id;
            opt.textContent = p.name;
            if (String(p.id) === selected) opt.selected = true;
            select.appendChild(opt);
          });
        });
        if (showAlerts) alert('Paths loaded successfully from AniWorld Downloader!');
      } else {
        if (showAlerts) alert('AniWorld API returned an error: ' + (data.error || 'Unknown Error'));
      }
    } catch (err) {
      if (showAlerts) alert('Failed to load paths. Ensure AniWorld URL is correct, saved, and the container is in the correct network.');
    }
  }

  // Load paths silently on page load
  window.addEventListener('load', () => fetchPaths(false));
</script>
<%- include('partials/footer') %>
