<%- include('partials/header') %>
<div class="mt-4">
  <h2>Accepted Requests</h2>
  <p>Latest requests automatically accepted by Seerr and sent to AniWorld (showing up to 100).</p>

  <div class="table-responsive">
    <table class="table table-striped">
      <thead>
        <tr>
          <th>ID</th>
          <th>Title</th>
          <th>Type</th>
          <th>Requester</th>
          <th>Status</th>
          <th>Date</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (requests.length === 0) { %>
          <tr>
            <td colspan="7" class="text-center">No requests yet.</td>
          </tr>
        <% } else { %>
          <% requests.forEach(function(req) { %>
            <% const status = req.status || ''; %>
            <% const ts = req.timestamp ? String(req.timestamp) : ''; %>
            <% const iso = ts && !/Z$/.test(ts) ? ts.replace(' ', 'T') + 'Z' : ts; %>
            <tr>
              <td><%= req.seerr_request_id %></td>
              <td><strong><%= req.title %></strong></td>
              <td><span class="badge bg-secondary"><%= req.type %></span></td>
              <td><%= req.requester %></td>
              <td>
                <% if (status.startsWith('Queued')) { %>
                  <span class="badge bg-success"><%= status %></span>
                <% } else if (status === 'Pending Approval') { %>
                  <span class="badge bg-warning text-dark">Pending</span>
                <% } else if (status === 'Processing Download...') { %>
                  <span class="badge bg-info text-dark">Processing...</span>
                <% } else if (status === 'Test received') { %>
                  <span class="badge bg-primary">Test received</span>
                <% } else { %>
                  <span class="badge bg-danger">Error: <%= status %></span>
                <% } %>
              </td>
              <td><time datetime="<%= iso %>"><%= ts %> UTC</time></td>
              <td>
                <form action="/delete-request" method="POST" class="d-inline">
                  <input type="hidden" name="seerr_request_id" value="<%= req.seerr_request_id %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this request?')">Delete</button>
                </form>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/footer') %>
