<%- include('partials/header', { hideNav: true }) %>
<div class="mt-5 mx-auto" style="max-width: 360px;">
  <h2>Login</h2>
  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>
  <form method="POST" action="/login">
    <div class="mb-3">
      <label class="form-label" for="password">Admin Password</label>
      <input type="password" class="form-control" name="password" id="password" required autofocus autocomplete="current-password">
    </div>
    <button type="submit" class="btn btn-primary w-100">Login</button>
  </form>
</div>
<%- include('partials/footer') %>
